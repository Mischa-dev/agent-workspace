AGENT_WORKSPACE_ENV=development
AGENT_WORKSPACE_SERVER_ADDR=127.0.0.1:3100
AGENT_WORKSPACE_WEBHOOK_ADDR=127.0.0.1:3101
AGENT_WORKSPACE_ALLOWED_ORIGINS=http://127.0.0.1:3100,http://localhost:3100,http://127.0.0.1:5173,http://localhost:5173
# The address people open the app at; links the server hands out use it.
# AGENT_WORKSPACE_PUBLIC_ORIGIN=https://workspace.example.com
AGENT_WORKSPACE_DATABASE_URL=postgres://agent_workspace:change-me@127.0.0.1:55432/agent_workspace
AGENT_WORKSPACE_DATA_ROOT=.agent-workspace
AGENT_WORKSPACE_DATA_QUOTA_BYTES=21474836480
AGENT_WORKSPACE_MINIMUM_FREE_BYTES=5368709120
AGENT_WORKSPACE_WEB_ROOT=apps/web/dist
AGENT_WORKSPACE_CODEX_BINARY=codex
AGENT_WORKSPACE_CODEX_HOME_ROOT=.agent-workspace/codex/profiles
AGENT_WORKSPACE_CODEX_HOST_CONCURRENCY_LIMIT=1
AGENT_WORKSPACE_CODEX_MAX_LINE_BYTES=1048576
AGENT_WORKSPACE_CODEX_MAX_STDERR_BYTES=262144
AGENT_WORKSPACE_CODEX_MAX_BUFFERED_EVENTS=64
AGENT_WORKSPACE_CODEX_REQUEST_TIMEOUT_SECONDS=120
AGENT_WORKSPACE_CODEX_SHUTDOWN_TIMEOUT_SECONDS=5
AGENT_WORKSPACE_DEMO_EXECUTOR=false
AGENT_WORKSPACE_LOG_FILTER=agent_workspace=debug,tower_http=info

# Development spikes only. Generate high-entropy values; never commit them.
AGENT_WORKSPACE_MCP_BEARER_TOKEN=

# Optional production-shaped GitHub App integration. Configure all three or
# none. Secret files must be absolute, regular, mode 0400, and outside the
# repository, release, and runtime data roots.
AGENT_WORKSPACE_GITHUB_APP_ID=
AGENT_WORKSPACE_GITHUB_PRIVATE_KEY_PATH=
AGENT_WORKSPACE_GITHUB_WEBHOOK_SECRET_PATH=
# Set only during a bounded webhook-secret cutover, then remove after the old
# signature is proven rejected.
AGENT_WORKSPACE_GITHUB_WEBHOOK_PREVIOUS_SECRET_PATH=
AGENT_WORKSPACE_GITHUB_API_BASE_URL=https://api.github.com
AGENT_WORKSPACE_GITHUB_API_VERSION=2026-03-10
# Optional: let people connect GitHub from Settings (install the App, then
# pick repositories) instead of typing installation and repository IDs. Set
# all three: the App's URL name (github.com/apps/<slug>), its OAuth client
# ID, and a file holding its client secret (same rules as the files above).
# In the App's settings, set the callback URL and the setup URL to
# <public origin>/api/v1/integrations/github/callback, tick "Request user
# authorization (OAuth) during installation" and "Redirect on update".
AGENT_WORKSPACE_GITHUB_APP_SLUG=
AGENT_WORKSPACE_GITHUB_CLIENT_ID=
AGENT_WORKSPACE_GITHUB_CLIENT_SECRET_PATH=

# Optional WorkOS AuthKit. Leave unset until both production values are ready.
# The API key file must be private, absolute, and outside runtime/web roots.
# AGENT_WORKSPACE_WORKOS_CLIENT_ID=client_...
# AGENT_WORKSPACE_WORKOS_API_KEY_PATH=/etc/agent-workspace/secrets/workos-api-key
# AGENT_WORKSPACE_WORKOS_ALLOW_SIGNUP=false

# Optional WorkOS Google and agent authentication; configure the provider first.
# AGENT_WORKSPACE_WORKOS_AUTHKIT_DOMAIN=https://your-environment.authkit.app
# AGENT_WORKSPACE_WORKOS_GOOGLE_ENABLED=false
# AGENT_WORKSPACE_WORKOS_AGENT_REGISTRATION_ENABLED=false

# Optional: the request header your proxy puts the caller's address in, for
# per-address sign-in limits (cf-connecting-ip behind Cloudflare). Unset, no
# address is read from requests. Set it only when every request comes through
# that proxy.
# AGENT_WORKSPACE_CLIENT_ADDRESS_HEADER=cf-connecting-ip
