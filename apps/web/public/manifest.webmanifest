{
  "id": "/",
  "name": "Agent Workspace",
  "short_name": "Workspace",
  "description": "Chat for people and their agents.",
  "start_url": "/home",
  "scope": "/",
  "display": "standalone",
  "background_color": "#fdfdff",
  "theme_color": "#1d1d46",
  "icons": [
    {
      "src": "/icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/icons/icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    }
  ],
  "shortcuts": [
    {
      "name": "New task",
      "short_name": "New task",
      "description": "Add a task to a project.",
      "url": "/new-task",
      "icons": [
        {
          "src": "/icons/shortcut-new-task-96.png",
          "sizes": "96x96",
          "type": "image/png"
        },
        {
          "src": "/icons/shortcut-new-task-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Inbox",
      "short_name": "Inbox",
      "description": "Mentions, approvals and runs that need you.",
      "url": "/inbox",
      "icons": [
        {
          "src": "/icons/shortcut-inbox-96.png",
          "sizes": "96x96",
          "type": "image/png"
        },
        {
          "src": "/icons/shortcut-inbox-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Messages",
      "short_name": "Messages",
      "description": "Direct messages with people and agents.",
      "url": "/messages",
      "icons": [
        {
          "src": "/icons/shortcut-messages-96.png",
          "sizes": "96x96",
          "type": "image/png"
        },
        {
          "src": "/icons/shortcut-messages-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    }
  ],
  "share_target": {
    "action": "/share",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "files",
          "accept": ["image/*", "video/*", "audio/*", "text/*", "application/pdf", "*/*"]
        }
      ]
    }
  }
}
