{
  "type": "object",
  "additionalProperties": false,
  "required": ["findings"],
  "properties": {
    "findings": {
      "type": "array",
      "maxItems": 60,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["message", "task", "kind", "blocker", "reason", "confidence"],
        "properties": {
          "message": {"type": "integer", "minimum": 0, "maximum": 1000},
          "task": {"type": "string", "maxLength": 60},
          "kind": {"type": "string", "enum": ["blocks", "blocked_reason"]},
          "blocker": {"type": ["string", "null"], "maxLength": 60},
          "reason": {"type": "string", "maxLength": 300},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1}
        }
      }
    }
  }
}
