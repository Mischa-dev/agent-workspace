{
  "name": "agent-workspace-private",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "node scripts/control.mjs dev",
    "setup": "node scripts/control.mjs setup",
    "start": "node scripts/control.mjs start",
    "stop": "node scripts/control.mjs stop",
    "status": "node scripts/control.mjs status",
    "build": "pnpm --filter @workspace/web build && tsc -p apps/server/tsconfig.json",
    "typecheck": "tsc --noEmit -p apps/server/tsconfig.json && tsc --noEmit -p apps/web/tsconfig.json",
    "test": "tsx --test tests/*.test.ts",
    "db:migrate": "tsx apps/server/src/migrate.ts",
    "backup": "node scripts/control.mjs backup",
    "restore": "node scripts/control.mjs restore",
    "trigger": "node scripts/trigger.mjs"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.2",
    "@fastify/multipart": "10.1.1",
    "@fastify/static": "10.1.4",
    "drizzle-orm": "0.45.2",
    "fastify": "5.12.5",
    "pg": "8.23.0",
    "pg-boss": "12.33.2",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "24.13.6",
    "@types/pg": "8.23.1",
    "drizzle-kit": "0.31.10",
    "tsx": "4.23.14",
    "typescript": "5.9.3"
  }
}
