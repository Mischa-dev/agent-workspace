[Unit]
Description=Daily Agent Workspace encrypted off-host backup
After=agent-workspace.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
UMask=0077
WorkingDirectory=/tmp
# Settings (remote, recipients, retention) live in /etc/agent-workspace/backup.env.
# See docs/operations/backups.md.
ExecStart=/opt/agent-workspace/current/bin/agent-workspace-backup --config /etc/agent-workspace/backup.env
# The secrets key goes to its own recipient and remote, and only when it changed.
ExecStart=/opt/agent-workspace/current/bin/agent-workspace-backup-key --config /etc/agent-workspace/backup.env
# Stay out of the way of the live app and anything else on the host. pg_dump
# itself runs inside the PostgreSQL container, so these limits cover the
# compression, encryption, archive and upload work done here.
Nice=19
CPUSchedulingPolicy=batch
IOSchedulingClass=idle
CPUQuota=50%
MemoryHigh=512M
MemoryMax=1G
TimeoutStartSec=4h
