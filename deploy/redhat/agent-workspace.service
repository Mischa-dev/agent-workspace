[Unit]
Description=Agent Workspace application host
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=agent-workspace
Group=agent-workspace
WorkingDirectory=/var/lib/agent-workspace
Environment=HOME=/var/lib/agent-workspace
Environment=PATH=/opt/agent-workspace/toolchains/node-v24.18.1-linux-arm64/bin:/usr/local/bin:/usr/bin
Environment=AGENT_WORKSPACE_WEB_ROOT=/opt/agent-workspace/current/web
EnvironmentFile=/etc/agent-workspace/agent-workspace.env
ExecStart=/opt/agent-workspace/current/bin/agent-workspace-server
Restart=on-failure
RestartSec=3s
KillMode=control-group
TimeoutStopSec=20s
UMask=0077

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectClock=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
CapabilityBoundingSet=
AmbientCapabilities=
ReadWritePaths=/var/lib/agent-workspace
ReadOnlyPaths=/opt/agent-workspace

[Install]
WantedBy=multi-user.target
