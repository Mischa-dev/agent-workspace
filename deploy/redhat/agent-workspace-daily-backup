#!/usr/bin/bash
# The daily backup unit's one command: back up the secrets key, then the
# database and data. Each is attempted even when the other fails, so a broken
# database backup never leaves a freshly rotated key only on this host. Exits
# nonzero if either failed.
#
# usage: agent-workspace-daily-backup [--config FILE]
set -uo pipefail

script_dir="$(dirname -- "$(readlink -f -- "${BASH_SOURCE[0]}")")"
status=0
"${script_dir}/agent-workspace-backup-key" "$@" || status=1
"${script_dir}/agent-workspace-backup" "$@" || status=1
exit "${status}"
