# /etc/agent-workspace/backup.env  (root:root, mode 0600)
# Read by agent-workspace-backup, agent-workspace-backup-key and
# agent-workspace-restore-drill. Plain KEY=value lines; nothing is expanded.
# See docs/operations/backups.md.

# --- Database backups -------------------------------------------------------
# age public key(s) the dumps are encrypted to, one per line.
BACKUP_AGE_RECIPIENTS_FILE=/etc/agent-workspace/backup-recipients.txt
# Where the encrypted sets are copied. ssh:[user@]host:/path uses rsync over
# ssh; local:/path copies to a directory on this machine (testing only).
BACKUP_REMOTE=ssh:backup@backup-host.example:/srv/backups/agent-workspace/data
BACKUP_SSH_IDENTITY=/etc/agent-workspace/backup-ssh/id_ed25519
BACKUP_SSH_KNOWN_HOSTS=/etc/agent-workspace/backup-ssh/known_hosts
BACKUP_SSH_PORT=22

# Local copies (one directory per set).
BACKUP_LOCAL_DIR=/var/backups/agent-workspace/encrypted
# Retention: delete sets older than N days, but always keep the newest K.
BACKUP_LOCAL_KEEP_DAYS=7
BACKUP_REMOTE_KEEP_DAYS=30
BACKUP_KEEP_MIN=3

# Data that cannot be rebuilt, relative to the data root. Repository mirrors
# and worktrees are skipped; they are re-cloned.
BACKUP_DATA_ROOT=/var/lib/agent-workspace
BACKUP_DATA_PATHS=attachments artifacts codex/profiles
# Optional tar --exclude patterns, space separated.
BACKUP_DATA_EXCLUDES=

# Live database name, and the database used to run CREATE/DROP DATABASE.
BACKUP_DATABASE=agent_workspace
BACKUP_MAINTENANCE_DATABASE=postgres

# --- Secrets key (keyring) --------------------------------------------------
# Same file as AGENT_WORKSPACE_SECRETS_KEY_PATH in agent-workspace.env.
# It is encrypted to a DIFFERENT recipient and sent to a DIFFERENT place.
BACKUP_SECRETS_KEY_FILE=/etc/agent-workspace/secrets/keyring
BACKUP_KEY_AGE_RECIPIENTS_FILE=/etc/agent-workspace/backup-key-recipients.txt
BACKUP_KEY_REMOTE=ssh:backup@other-host.example:/srv/backups/agent-workspace/key

# --- Restore drill ----------------------------------------------------------
# Spare database the drill restores into; it refuses the live name.
BACKUP_DRILL_DATABASE=agent_workspace_restore_drill
# The private age key for the DATABASE recipient. Keep it off this host and
# pass it with --identity for the drill instead of setting it here.
#BACKUP_AGE_IDENTITY_FILE=/root/drill-identity.txt

# --- Rarely changed ---------------------------------------------------------
#BACKUP_RELEASE_BIN=/opt/agent-workspace/current/bin
#BACKUP_STATE_DIR=/var/lib/agent-workspace-backup
#BACKUP_WORK_DIR=/var/tmp
