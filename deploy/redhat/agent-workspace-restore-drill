#!/usr/bin/bash
# Restore drill: fetch the newest off-host backup set, verify its checksums,
# decrypt it, restore the dump into a spare database, run sanity queries,
# prove the restored secrets open with a backed-up key set, report, and drop
# the spare database (unless --keep).
#
# usage: agent-workspace-restore-drill [--config FILE] [--identity FILE]
#          [--key-identity FILE] [--skip-secrets] [--from remote|local]
#          [--set NAME] [--database NAME] [--replace] [--keep]
set -euo pipefail

script_dir="$(dirname -- "$(readlink -f -- "${BASH_SOURCE[0]}")")"
# shellcheck source=agent-workspace-backup-lib.sh
source "${script_dir}/agent-workspace-backup-lib.sh"

usage() {
  sed -n '7,9p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//' >&2
  exit 64
}

config="${BACKUP_DEFAULT_CONFIG}"
identity=""
key_identity=""
skip_secrets=false
from=remote
set_name=""
database=""
keep=false
replace=false
while (($# > 0)); do
  case "$1" in
    --config) config="${2:?}"; shift 2 ;;
    --identity) identity="${2:?}"; shift 2 ;;
    --key-identity) key_identity="${2:?}"; shift 2 ;;
    --skip-secrets) skip_secrets=true; shift ;;
    --from) from="${2:?}"; shift 2 ;;
    --set) set_name="${2:?}"; shift 2 ;;
    --database) database="${2:?}"; shift 2 ;;
    --keep) keep=true; shift ;;
    --replace) replace=true; shift ;;
    *) usage ;;
  esac
done

load_config "${config}"
apply_common_defaults
: "${BACKUP_DRILL_DATABASE:=agent_workspace_restore_drill}"
[[ -n "${database}" ]] || database="${BACKUP_DRILL_DATABASE}"
[[ -n "${identity}" ]] || identity="${BACKUP_AGE_IDENTITY_FILE:-}"
[[ -n "${key_identity}" ]] || key_identity="${BACKUP_KEY_AGE_IDENTITY_FILE:-}"
: "${BACKUP_SERVER_BIN:=${BACKUP_RELEASE_BIN}/agent-workspace-server}"
[[ -n "${identity}" ]] || die "pass --identity or set BACKUP_AGE_IDENTITY_FILE (the private age key)"
require_file "age identity" "${identity}"
validate_identifier "drill database" "${database}"
case "${database}" in
  "${BACKUP_DATABASE}" | "${BACKUP_MAINTENANCE_DATABASE}" | postgres | template0 | template1)
    die "refusing to restore into ${database}: it is the live or a system database"
    ;;
esac
[[ -z "${set_name}" || "${set_name}" =~ ${SET_NAME_PATTERN} ]] || die "--set must be a set name like 20260101T033000Z"
[[ -x "${BACKUP_PG_RESTORE}" ]] || die "BACKUP_PG_RESTORE (${BACKUP_PG_RESTORE}) is not executable"
[[ -x "${BACKUP_PSQL}" ]] || die "BACKUP_PSQL (${BACKUP_PSQL}) is not executable"
require_tools age tar gzip sha256sum flock

case "${from}" in
  remote)
    require_setting BACKUP_REMOTE
    require_transport_tools "${BACKUP_REMOTE}"
    available="$(remote_list "${BACKUP_REMOTE}")"
    ;;
  local)
    available="$(local_list "${BACKUP_LOCAL_DIR}")"
    ;;
  *) die "--from must be remote or local" ;;
esac
if [[ -z "${set_name}" ]]; then
  set_name="$(tail -n 1 <<<"${available}")"
  [[ -n "${set_name}" ]] || die "no backup sets found (${from})"
elif ! grep -qxF -- "${set_name}" <<<"${available}"; then
  die "set ${set_name} not found (${from})"
fi

take_lock restore-drill
umask 0077

maintenance_sql() {
  PGDATABASE="${BACKUP_MAINTENANCE_DATABASE}" "${BACKUP_PSQL}" -X -A -t -q -v ON_ERROR_STOP=1 -c "$1"
}
drill_sql() {
  PGDATABASE="${database}" "${BACKUP_PSQL}" -X -A -t -q -v ON_ERROR_STOP=1 -c "$1"
}

work="$(mktemp -d -p "${BACKUP_WORK_DIR}" agent-workspace-drill.XXXXXX)"
created_database=false
cleanup() {
  local status=$?
  rm -rf -- "${work:?}"
  if [[ "${created_database}" == true && "${keep}" == false ]]; then
    maintenance_sql "DROP DATABASE IF EXISTS \"${database}\" WITH (FORCE)" || true
    log "dropped spare database ${database}"
  fi
  exit "${status}"
}
trap cleanup EXIT

log "drill: fetching set ${set_name} (${from})"
if [[ "${from}" == remote ]]; then
  remote_get_set "${BACKUP_REMOTE}" "${set_name}" "${work}"
else
  cp -a -- "${BACKUP_LOCAL_DIR}/${set_name}/." "${work}/"
fi

# Only names we expect may appear in the checksum list.
[[ -f "${work}/SHA256SUMS" ]] || die "SHA256SUMS is missing from the set"
listed="$(sed -E 's/^[0-9a-f]{64}  //' "${work}/SHA256SUMS" | sort | tr '\n' ' ')"
[[ "${listed}" == "backup-info data.tar.gz.age database.dump.age " ]] \
  || die "SHA256SUMS lists unexpected files: ${listed}"
(cd -- "${work}" && sha256sum --check --strict --quiet SHA256SUMS) || die "checksum mismatch"
log "drill: checksums verified"

expected_version="$(sed -n 's/^migration_version=//p' "${work}/backup-info")"
[[ "${expected_version}" =~ ^[0-9]+$ ]] || die "backup-info has no migration version"

exists="$(maintenance_sql "SELECT count(*) FROM pg_database WHERE datname = '${database}'")"
if [[ "${exists}" != 0 ]]; then
  [[ "${replace}" == true ]] || die "database ${database} already exists; drop it or pass --replace"
  maintenance_sql "DROP DATABASE \"${database}\" WITH (FORCE)"
fi
maintenance_sql "CREATE DATABASE \"${database}\""
created_database=true
log "drill: created spare database ${database}"

decrypt_stream "${identity}" "${work}/database.dump.age" \
  | PGDATABASE="${database}" "${BACKUP_PG_RESTORE}" \
    --dbname="${database}" --no-owner --no-privileges --exit-on-error
log "drill: database restored"

# The data archive is decrypted and read end to end, not unpacked.
data_entries="$(decrypt_stream "${identity}" "${work}/data.tar.gz.age" | tar --list --gzip --file=- | wc -l)"
log "drill: data archive readable"

organizations="$(drill_sql 'SELECT count(*) FROM organizations')"
projects="$(drill_sql 'SELECT count(*) FROM projects')"
messages="$(drill_sql 'SELECT count(*) FROM messages')"
restored_version="$(drill_sql 'SELECT coalesce(max(version), 0) FROM _sqlx_migrations')"
failed_migrations="$(drill_sql 'SELECT count(*) FROM _sqlx_migrations WHERE NOT success')"

# The dump holds secrets only as ciphertext; they are worth something only if
# a backed-up key set opens them. Try key sets newest first until one opens
# every restored secret. The keyring is decrypted straight into the checker's
# stdin and never written to disk.
secrets_result="none stored"
secret_count=0
if [[ "$(drill_sql "SELECT count(*) FROM pg_catalog.pg_tables WHERE schemaname = 'public' AND tablename = 'secrets'")" == 1 ]]; then
  secret_count="$(drill_sql 'SELECT count(*) FROM secrets')"
fi
if ((secret_count > 0)) && [[ "${skip_secrets}" == true ]]; then
  secrets_result="${secret_count} stored, NOT CHECKED (--skip-secrets)"
  log "drill: warning: ${secret_count} restored secrets were not checked against a key backup"
elif ((secret_count > 0)); then
  [[ -n "${key_identity}" ]] \
    || die "${secret_count} secrets restored; pass --key-identity (or set BACKUP_KEY_AGE_IDENTITY_FILE) to prove a key backup opens them, or --skip-secrets"
  require_file "key age identity" "${key_identity}"
  require_setting BACKUP_KEY_REMOTE
  require_transport_tools "${BACKUP_KEY_REMOTE}"
  [[ -x "${BACKUP_SERVER_BIN}" ]] || die "BACKUP_SERVER_BIN (${BACKUP_SERVER_BIN}) is not executable"
  export_sql="$("${BACKUP_SERVER_BIN}" secrets-verify-export --print-query)"
  drill_sql "${export_sql}" >"${work}/secret-rows"
  key_sets="$(remote_list "${BACKUP_KEY_REMOTE}" | sort -r)"
  [[ -n "${key_sets}" ]] || die "${secret_count} secrets restored but no key sets are off-host"
  opened_with=""
  while IFS= read -r key_set; do
    fetched="${work}/key-${key_set}"
    install -d -m 0700 "${fetched}"
    remote_get_set "${BACKUP_KEY_REMOTE}" "${key_set}" "${fetched}" || continue
    (cd -- "${fetched}" && sha256sum --status -c SHA256SUMS) || continue
    if decrypt_stream "${key_identity}" "${fetched}/secrets-key.age" \
      | "${BACKUP_SERVER_BIN}" secrets-verify-export --rows "${work}/secret-rows" >/dev/null 2>&1; then
      opened_with="${key_set}"
      break
    fi
  done <<<"${key_sets}"
  [[ -n "${opened_with}" ]] || die "none of the off-host key sets opens all ${secret_count} restored secrets"
  secrets_result="${secret_count} stored, all open with key set ${opened_with}"
  log "drill: restored secrets open with key set ${opened_with}"
fi

cat <<REPORT
restore drill report
  set:                ${set_name} (${from})
  spare database:     ${database}
  organizations:      ${organizations}
  projects:           ${projects}
  messages:           ${messages}
  latest migration:   ${restored_version} (at least ${expected_version} expected)
  failed migrations:  ${failed_migrations}
  data archive files: ${data_entries}
  secrets:            ${secrets_result}
  after the drill:    $([[ "${keep}" == true ]] && echo "kept" || echo "dropped")
REPORT

# The recorded version is sampled just before the dump, so the dump may be
# newer (a migration landed during it) but never older.
(( restored_version >= expected_version )) || die "restored migration version is older than the backup recorded"
[[ "${failed_migrations}" == 0 ]] || die "restored database lists failed migrations"
log "drill: passed"
