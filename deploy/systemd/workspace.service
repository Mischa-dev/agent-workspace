[Unit]
Description=Private agent workspace containers
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
Delegate=yes
KillMode=process
WorkingDirectory=/home/OWNER/agent-workspace
Environment=WORKSPACE_DEPLOY_DIR=/home/OWNER/agent-workspace/.local/deployment
ExecStart=/usr/bin/node /home/OWNER/agent-workspace/scripts/deploy-podman.mjs resume
ExecStop=/usr/bin/node /home/OWNER/agent-workspace/scripts/deploy-podman.mjs stop
TimeoutStartSec=120
TimeoutStopSec=90
UMask=0077

[Install]
WantedBy=default.target
