[Unit]
Description=Answer Agent Workspace reply requests for AgentOS crew member %i
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/run/current-system/sw/bin/python3 %h/.local/share/agent-workspace-aw-bridge/bridge.py --agent %i
WorkingDirectory=%h
UMask=0077
NoNewPrivileges=true
# PrivateTmp in a user unit maps the root controller's peer UID to 65534.
# AgentOS must see UID 0 to verify its controller before sending a request.
MemoryMax=256M
CPUQuota=50%
TimeoutStartSec=65min
