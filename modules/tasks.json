{
  "id": "tasks",
  "name": "Tasks",
  "description": "Tasks and the ways to see them: a list, a board, a timeline, milestones, planning, labels, saved views and templates.",
  "version": 1,
  "kind": "core",
  "switchable": true,
  "needs": ["projects"],
  "worksWith": ["pages", "runs", "code", "channels"],
  "permissions": ["tasks.view", "tasks.create", "tasks.edit", "tasks.delete", "tasks.workflow"],
  "tools": {
    "workflow_get": "describe",
    "workflow_update": "change",
    "task_list": "query",
    "task_open": "describe",
    "task_create": "create",
    "task_update": "change",
    "task_create_many": "create",
    "task_update_many": "change",
    "task_criteria": "change",
    "task_comment": "create",
    "task_comment_edit": "change",
    "task_comment_delete": "change",
    "task_mark_blocked": "change",
    "task_mark_ready_for_review": "change",
    "task_reorder": "change",
    "task_claim": "change",
    "task_release": "change",
    "task_link": "change",
    "task_move": "change",
    "task_depend": "change",
    "task_relate": "change",
    "task_watch": "change",
    "task_ready_list": "query",
    "task_from_template": "create",
    "task_import": "create",
    "label_list": "query",
    "label_write": "change",
    "field_list": "query",
    "field_write": "change",
    "view_list": "query",
    "view_write": "change",
    "my_work": "query",
    "template_list": "query",
    "template_write": "change",
    "recurring_write": "change",
    "milestone_list": "query",
    "milestone_write": "change",
    "dependency_graph": "query",
    "plan_import": "create"
  },
  "routes": [
    "/api/v1/my-work",
    "/api/v1/projects/{project_id}/work-items*",
    "/api/v1/projects/{project_id}/work-item-*",
    "/api/v1/projects/{project_id}/labels*",
    "/api/v1/projects/{project_id}/fields*",
    "/api/v1/projects/{project_id}/milestones*",
    "/api/v1/projects/{project_id}/views*",
    "/api/v1/projects/{project_id}/timeline",
    "/api/v1/projects/{project_id}/task-templates*",
    "/api/v1/projects/{project_id}/recurring-tasks*",
    "/api/v1/projects/{project_id}/imports*",
    "/api/v1/projects/{project_id}/ai/plans*",
    "/api/v1/projects/{project_id}/ai/graph",
    "/api/v1/projects/{project_id}/ai/ready",
    "/api/v1/projects/{project_id}/bug-report-links",
    "/api/v1/bug-report-links/*",
    "/api/v1/bug-reports/*"
  ],
  "events": { "emits": ["task.created", "task.updated"], "listens": ["run.finished", "pull_request.merged"] },
  "notifications": ["assigned", "comment_mention", "task_changed", "ai_plan_import"],
  "search": ["tasks"],
  "automations": { "triggers": ["task_created", "task_matches"], "actions": ["set_field"] },
  "things": [
    {
      "kind": "task",
      "one": "Task",
      "many": "Tasks",
      "href": "/projects/{projectId}/work-items/{id}",
      "fields": [
        { "id": "key", "label": "Key", "type": "text" },
        { "id": "priority", "label": "Priority", "type": "single_choice", "options": ["no_priority", "low", "medium", "high", "urgent"] },
        { "id": "dueDate", "label": "Due", "type": "date" },
        { "id": "estimate", "label": "Estimate", "type": "number" },
        { "id": "labels", "label": "Labels", "type": "labels" }
      ]
    },
    {
      "kind": "milestone",
      "one": "Milestone",
      "many": "Milestones",
      "href": "/projects/{projectId}/milestones",
      "fields": [{ "id": "dueDate", "label": "Due", "type": "date" }]
    }
  ],
  "links": [
    { "kind": "part_of", "from": "task", "to": "task" },
    { "kind": "blocks", "from": "task", "to": "task" },
    { "kind": "relates_to", "from": "task", "to": "task" },
    { "kind": "duplicates", "from": "task", "to": "task" },
    { "kind": "part_of", "from": "task", "to": "milestone" },
    { "kind": "about", "from": "task", "to": "page" },
    { "kind": "about", "from": "task", "to": "decision" },
    { "kind": "about", "from": "task", "to": "thread" },
    { "kind": "about", "from": "task", "to": "conversation" }
  ],
  "embeds": [
    {
      "id": "tasks.list",
      "label": "Task list",
      "description": "Tasks from a saved view or filter, live.",
      "thing": "task",
      "piece": { "type": "list", "thing": "task", "fields": ["key", "status", "owner", "dueDate"], "groupBy": "status" }
    },
    {
      "id": "tasks.table",
      "label": "Task table",
      "description": "Tasks with their fields in columns; a list of cards on a phone.",
      "thing": "task",
      "piece": { "type": "table", "thing": "task", "fields": ["key", "status", "priority", "owner", "dueDate", "estimate"] }
    },
    {
      "id": "tasks.board",
      "label": "Task board",
      "description": "Tasks as cards in a column for each status.",
      "thing": "task",
      "piece": { "type": "board", "thing": "task", "fields": ["key", "owner", "priority"], "groupBy": "status" }
    },
    {
      "id": "tasks.card",
      "label": "Task",
      "description": "One task with its status, owner and due date.",
      "thing": "task",
      "piece": { "type": "card", "thing": "task", "fields": ["key", "status", "owner", "dueDate"], "actions": ["open"] }
    }
  ],
  "slots": {
    "pages": [
      "/new-task",
      "/share",
      "/my-work",
      "/:taskKey",
      "/projects/:projectId/work-items",
      "/projects/:projectId/work-items/:workItemId",
      "/projects/:projectId/milestones",
      "/projects/:projectId/next",
      "/projects/:projectId/graph",
      "/projects/:projectId/plan-import",
      "/projects/:projectId/timeline"
    ],
    "parts": [
      "area.tasks",
      "area.board",
      "area.timeline",
      "area.milestones",
      "area.planning",
      "area.bug_reports",
      "area.files",
      "task.type",
      "task.priority",
      "task.estimate",
      "task.custom_fields",
      "task.labels",
      "task.milestone",
      "task.dates",
      "task.dependencies",
      "task.criteria",
      "tech.task_keys",
      "workspace.my_work"
    ],
    "sidebar": [],
    "home": ["tasks"],
    "settings": ["project/workflow", "project/fields", "project/templates", "project/import-export", "project/bug-reports"],
    "palette": [
      "p:tasks",
      "p:board",
      "p:milestones",
      "p:timeline",
      "p:next",
      "p:ready",
      "p:graph",
      "p:plan-import",
      "a:create-task",
      "a:create-task:*",
      "g:my-work",
      "w:*",
      "k:*"
    ],
    "shortcuts": ["create-task", "go-my-work", "go-tasks", "go-board"],
    "slash": ["task"],
    "setup": ["tasks"]
  },
  "settings": [],
  "nouns": ["task", "milestone"]
}
