{
  "id": "automations",
  "name": "Automations",
  "description": "Rules that act on their own when something happens or on a schedule.",
  "version": 1,
  "order": 140,
  "kind": "core",
  "switchable": true,
  "needs": ["projects"],
  "worksWith": ["tasks", "runs", "messages"],
  "permissions": [],
  "tools": {
    "automation_list": "query",
    "automation_create": "create",
    "automation_update": "change",
    "automation_delete": "change",
    "automation_run_start": "create",
    "automation_history": "query",
    "incoming_hook_create": "create",
    "incoming_hook_list": "query",
    "incoming_hook_delete": "change"
  },
  "routes": [
    "/api/v1/projects/{project_id}/automations*",
    "/api/v1/incoming-hooks*"
  ],
  "events": {
    "emits": ["incoming_hook.received"],
    "listens": [
      "task.created",
      "task.updated",
      "run.updated",
      "run.finished",
      "pull_request.checks_failed",
      "pull_request.checks_passed",
      "pull_request.merged",
      "pull_request.closed",
      "message.created",
      "record.created",
      "record.updated"
    ]
  },
  "notifications": ["automation", "automation_disabled"],
  "search": [],
  "automations": {
    "triggers": ["schedule", "incoming_hook"],
    "actions": ["notify", "run_operation"]
  },
  "things": [
    {
      "kind": "automation",
      "one": "Automation",
      "many": "Automations",
      "href": "/settings/projects/{projectId}/automations",
      "fields": [{ "id": "trigger", "label": "When", "type": "text" }]
    }
  ],
  "links": [],
  "embeds": [],
  "slots": {
    "pages": [],
    "parts": ["area.automations"],
    "sidebar": [],
    "home": [],
    "settings": ["project/automations"],
    "palette": [],
    "shortcuts": [],
    "slash": [],
    "setup": []
  },
  "settings": [],
  "nouns": []
}
