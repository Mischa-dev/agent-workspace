{
  "id": "pages",
  "name": "Pages",
  "description": "Pages and decisions, in a project or for the whole workspace: guides, notes, plans, agent skills and what was decided. Every version is kept.",
  "version": 1,
  "order": 60,
  "kind": "core",
  "switchable": true,
  "needs": [],
  "worksWith": ["tasks", "whiteboards"],
  "permissions": ["pages.edit"],
  "tools": {
    "page_list": "query",
    "page_get": "describe",
    "page_blocks": "describe",
    "page_write": "change",
    "page_edit": "change",
    "page_comments": "query",
    "page_comment": "create",
    "page_comment_update": "change",
    "page_suggestions": "query",
    "page_suggestion_decide": "change",
    "skill_list": "query",
    "skill_get": "describe",
    "decision_list": "query",
    "decision_record": "create"
  },
  "routes": [
    "/api/v1/pages/*",
    "/api/v1/projects/{id}/pages",
    "/api/v1/projects/{id}/pages/import",
    "/api/v1/projects/{id}/decisions",
    "/api/v1/organizations/{organization_id}/pages-space"
  ],
  "events": { "emits": ["page.content_saved", "page.discussion_changed", "page.commented", "page.comment_changed", "decision.recorded", "decision.updated"], "listens": [] },
  "notifications": ["page_suggestion", "page_comment"],
  "search": ["pages", "decisions"],
  "automations": { "triggers": [], "actions": [] },
  "things": [
    {
      "kind": "page",
      "one": "Page",
      "many": "Pages",
      "href": "/projects/{projectId}/pages/{id}",
      "fields": [
        {
          "id": "tags",
          "label": "Tags",
          "type": "labels",
          "tones": { "Guide": "agent", "Skill": "agent", "Not updated in months": "warning" }
        },
        { "id": "updatedAt", "label": "Edited", "type": "date" },
        { "id": "excerpt", "label": "Start of the page", "type": "long_text" }
      ]
    },
    {
      "kind": "decision",
      "one": "Decision",
      "many": "Decisions",
      "href": "/projects/{projectId}/decisions",
      "fields": [
        { "id": "decidedAt", "label": "Decided", "type": "date" },
        { "id": "decidedBy", "label": "Decided by", "type": "person" },
        { "id": "source", "label": "In", "type": "link" },
        { "id": "detail", "label": "Why", "type": "long_text", "markdown": true }
      ]
    }
  ],
  "links": [],
  "embeds": [
    {
      "id": "pages.card",
      "label": "Page",
      "description": "A page's title, who edited it last and when.",
      "thing": "page",
      "piece": { "type": "card", "thing": "page", "fields": ["owner", "updatedAt"], "actions": ["open"] }
    }
  ],
  "web": { "folder": "memory" },
  "slots": {
    "pages": ["/pages", "/projects/:projectId/pages", "/projects/:projectId/pages/:pageId", "/projects/:projectId/decisions"],
    "parts": ["area.pages", "area.decisions", "page.live_editing", "page.comments", "page.import_export"],
    "sidebar": [],
    "home": [],
    "settings": [],
    "palette": ["p:pages", "p:decisions"],
    "shortcuts": ["go-pages", "go-decisions"],
    "slash": [],
    "setup": []
  },
  "settings": [],
  "nouns": ["page"]
}
