{
  "id": "pages",
  "name": "Pages",
  "description": "Pages and decisions, in a project or for the whole workspace: guides, notes, plans, agent skills and what was decided. Every version is kept.",
  "version": 1,
  "order": 60,
  "kind": "core",
  "switchable": true,
  "needs": [],
  "worksWith": ["tasks", "whiteboards"],
  "permissions": ["pages.edit", "pages.see", "pages.comment", "pages.suggest", "pages.edit_own"],
  "tools": {
    "page_list": "query",
    "page_get": "describe",
    "conversation_tab_list": "query",
    "conversation_tab_set": "change",
    "page_blocks_get": "describe",
    "page_create": "create",
    "page_update": "change",
    "page_template_list": "query",
    "page_update_blocks": "change",
    "page_comment_list": "query",
    "page_comment_create": "create",
    "page_comment_update": "change",
    "page_suggestion_list": "query",
    "page_suggestion_decide": "change",
    "change_list": "query",
    "change_undo": "change",
    "skill_list": "query",
    "skill_get": "describe",
    "decision_list": "query",
    "decision_record": "create",
    "thing_share_list": "query",
    "thing_share_add": "change",
    "thing_share_remove": "change",
    "thing_link_create": "create",
    "memory_page_open": "query",
    "memory_page_set": "change",
    "page_make": "create",
    "page_file_upload": "create",
    "page_move": "change"
  },
  "routes": [
    "/api/v1/pages/*",
    "/api/v1/shared/{token}",
    "/api/v1/public/pages/{token}",
    "/api/v1/projects/{id}/pages",
    "/api/v1/projects/{id}/pages/import",
    "/api/v1/projects/{id}/decisions",
    "/api/v1/organizations/{organization_id}/pages-space"
  ],
  "events": { "emits": ["page.content_saved", "page.updated", "page.discussion_changed", "page.commented", "page.comment_changed", "page.version_restored", "change.undone", "decision.recorded", "decision.updated", "thing.share_changed"], "listens": [] },
  "notifications": ["page_suggestion", "page_comment"],
  "search": ["pages", "decisions"],
  "automations": { "triggers": ["page_changed"], "actions": [] },
  "things": [
    {
      "kind": "page",
      "one": "Page",
      "many": "Pages",
      "href": "/projects/{projectId}/pages/{id}",
      "fields": [
        {
          "id": "tags",
          "label": "Tags",
          "type": "labels",
          "tones": { "Guide": "agent", "Skill": "agent", "Not updated in months": "warning" }
        },
        { "id": "updatedAt", "label": "Edited", "type": "date" },
        { "id": "excerpt", "label": "Start of the page", "type": "long_text" }
      ]
    },
    {
      "kind": "decision",
      "one": "Decision",
      "many": "Decisions",
      "href": "/projects/{projectId}/decisions",
      "fields": [
        { "id": "decidedAt", "label": "Decided", "type": "date" },
        { "id": "decidedBy", "label": "Decided by", "type": "person" },
        { "id": "source", "label": "In", "type": "link" },
        { "id": "detail", "label": "Why", "type": "long_text", "markdown": true }
      ]
    }
  ],
  "links": [],
  "embeds": [
    {
      "id": "pages.card",
      "label": "Page",
      "description": "A page's title, who edited it last and when.",
      "thing": "page",
      "piece": { "type": "card", "thing": "page", "fields": ["owner", "updatedAt"], "actions": ["open"] }
    }
  ],
  "web": { "folder": "memory" },
  "slots": {
    "pages": ["/pages", "/projects/:projectId/pages", "/projects/:projectId/pages/:pageId", "/projects/:projectId/decisions", "/p/:token"],
    "parts": ["area.pages", "area.decisions", "page.live_editing", "page.comments", "page.import_export", "page.nesting", "page.recent_edits", "page.move", "page.sharing", "talk.channel_memory", "channel.tabs"],
    "sidebar": [],
    "home": [],
    "settings": [],
    "palette": ["p:pages", "p:decisions"],
    "shortcuts": ["go-pages", "go-decisions"],
    "slash": [],
    "setup": []
  },
  "settings": [],
  "nouns": ["page"]
}
