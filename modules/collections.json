{
  "id": "collections",
  "name": "Collections",
  "description": "Record types a project makes for itself, such as Playtest feedback or Builds: fields, records and views, with the same field types as tasks.",
  "version": 1,
  "kind": "core",
  "switchable": true,
  "needs": ["projects"],
  "worksWith": ["tasks", "pages"],
  "permissions": ["collections.edit", "collections.build"],
  "tools": {
    "collection_list": "query",
    "collection_describe": "describe",
    "collection_write": "change",
    "record_query": "query",
    "record_write": "change"
  },
  "routes": ["/api/v1/projects/{project_id}/collections*", "/api/v1/forms/*"],
  "events": { "emits": ["record.created", "record.updated"], "listens": [] },
  "notifications": [],
  "search": ["records"],
  "automations": { "triggers": ["record_created", "record_changed"], "actions": [] },
  "things": [
    {
      "kind": "record",
      "one": "Record",
      "many": "Records",
      "href": "/projects/{projectId}/collections/{parentId}?record={id}",
      "fields": [{ "id": "updatedAt", "label": "Edited", "type": "date" }]
    }
  ],
  "links": [],
  "embeds": [],
  "slots": {
    "pages": ["/projects/:projectId/collections/*", "/forms/:token"],
    "parts": ["area.collections"],
    "sidebar": [],
    "home": [],
    "settings": [],
    "palette": ["p:collections"],
    "shortcuts": [],
    "slash": [],
    "setup": []
  },
  "settings": [],
  "nouns": []
}
