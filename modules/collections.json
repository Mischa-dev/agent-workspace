{
  "id": "collections",
  "name": "Collections",
  "description": "Record types a project makes for itself, such as Playtest feedback or Builds: fields, records and views, with the same field types as tasks.",
  "version": 1,
  "order": 80,
  "kind": "core",
  "switchable": true,
  "needs": ["projects"],
  "worksWith": ["tasks", "pages"],
  "permissions": ["collections.edit", "collections.build", "collections.comment", "collections.suggest", "data.connect", "data.share"],
  "tools": {
    "collection_list": "query",
    "collection_get": "describe",
    "formula_preview": "query",
    "button_get": "describe",
    "button_press": "change",
    "collection_create": "create",
    "collection_update": "change",
    "record_list": "query",
    "record_create": "create",
    "record_update": "change",
    "record_create_many": "create",
    "record_update_many": "change",
    "form_list": "query",
    "form_get": "describe",
    "form_create": "create",
    "form_update": "change",
    "form_answer_send": "create",
    "record_template_list": "query",
    "record_template_create": "create",
    "record_template_update": "change",
    "recurring_record_list": "query",
    "recurring_record_create": "create",
    "recurring_record_update": "change",
    "recurring_record_delete": "change",
    "view_list": "query",
    "view_create": "create",
    "view_update": "change",
    "view_delete": "change",
    "view_pin": "change",
    "view_default_set": "change",
    "data_connection_list": "query",
    "data_connection_create": "create",
    "data_connection_update": "change",
    "data_connection_delete": "change",
    "data_query_list": "query",
    "data_query_get": "describe",
    "data_query_create": "create",
    "data_query_update": "change",
    "data_query_review": "change",
    "data_query_share": "change",
    "data_query_run": "change",
    "data_query_delete": "change"
  },
  "routes": ["/api/v1/projects/{project_id}/collections*", "/api/v1/forms/*"],
  "events": { "emits": ["collection.updated", "record.created", "record.updated", "record.proposals_changed", "record.version_restored", "view.changed", "data_connection.changed", "data_query.changed"], "listens": [] },
  "notifications": ["form_paused"],
  "search": ["records"],
  "automations": { "triggers": ["record_created", "record_changed", "record_matches", "field_changed"], "actions": [] },
  "things": [
    {
      "kind": "collection",
      "one": "Collection",
      "many": "Collections",
      "href": "/projects/{projectId}/collections/{id}",
      "fields": [{ "id": "updatedAt", "label": "Edited", "type": "date" }]
    },
    {
      "kind": "record",
      "one": "Record",
      "many": "Records",
      "href": "/projects/{projectId}/collections/{parentId}?record={id}",
      "fields": [{ "id": "updatedAt", "label": "Edited", "type": "date" }]
    }
  ],
  "links": [],
  "embeds": [],
  "web": { "folder": "collections" },
  "slots": {
    "pages": ["/projects/:projectId/collections/*", "/forms/:token"],
    "parts": ["area.collections"],
    "sidebar": [],
    "home": [],
    "settings": [],
    "palette": ["p:collections"],
    "shortcuts": [],
    "slash": [],
    "setup": []
  },
