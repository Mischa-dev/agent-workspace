{
  "format": "agent-workspace-package/1",
  "id": "chat_with_agents",
  "version": "1.0.0",
  "name": "Chat with my agents",
  "description": "Just you and your agents talking: messages, the inbox and Later. No projects, tasks or runs to set up.",
  "target": "workspace",
  "contents": [
    {
      "kind": "switches",
      "key": "switches",
      "body": {
        "off": [
          "projects",
          "channels",
          "tasks",
          "pages",
          "whiteboards",
          "collections",
          "sheets",
          "code",
          "runs",
          "automations"
        ]
      }
    }
  ]
}
