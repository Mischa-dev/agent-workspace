{
  "format": "agent-workspace-package/1",
  "id": "software_team",
  "version": "1.0.0",
  "name": "Software team",
  "description": "Everything on, with code, runs and agents first: tasks become pull requests. Adds a Contractor role for outside help.",
  "target": "workspace",
  "contents": [
    {
      "kind": "switches",
      "key": "switches",
      "body": {
        "off": []
      }
    },
    {
      "kind": "layout",
      "key": "layout",
      "body": {
        "preset": "software_team",
        "changes": {},
        "words": {}
      }
    },
    {
      "kind": "role",
      "key": "contractor",
      "body": {
        "name": "Contractor",
        "description": "Works on tasks and code they're given: no new channels, no approving runs, no deleting.",
        "baseRole": "member",
        "permissions": [
          "projects.view",
          "tasks.view",
          "tasks.create",
          "tasks.edit",
          "channels.post",
          "pages.edit",
          "whiteboards.edit",
          "collections.edit",
          "sheets.edit",
          "runs.launch",
          "runs.interrupt",
          "code.view",
          "code.publish",
          "directory.view"
        ]
      }
    },
    {
      "kind": "role",
      "key": "member",
      "body": {
        "name": "Member",
        "default": true
      }
    },
    {
      "kind": "space",
      "key": "engineering",
      "body": {
        "name": "Engineering",
        "key": "ENG"
      }
    },
    {
      "kind": "channels",
      "key": "channels",
      "body": {
        "channels": [
          {
            "name": "general"
          },
          {
            "name": "releases"
          },
          {
            "name": "incidents"
          }
        ]
      }
    },
    {
      "kind": "collection",
      "key": "releases",
      "body": {
        "name": "Releases",
        "description": "What shipped and when.",
        "titleName": "Version",
        "fields": [
          {
            "name": "Date",
            "type": "date"
          },
          {
            "name": "Status",
            "type": "single_choice",
            "options": [
              {
                "name": "Planned",
                "color": "gray"
              },
              {
                "name": "In progress",
                "color": "blue"
              },
              {
                "name": "Shipped",
                "color": "green"
              }
            ]
          },
          {
            "name": "Notes",
            "type": "text"
          }
        ],
        "views": [
          {
            "name": "All records",
            "type": "table"
          }
        ]
      }
    }
  ],
  "needsAdmin": [
    "role:contractor",
    "role:member"
  ]
}
