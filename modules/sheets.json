{
  "id": "sheets",
  "name": "Sheets",
  "description": "Spreadsheets in a project: tabs of cells with formulas, worked out on the server, that people and agents edit together.",
  "version": 1,
  "order": 90,
  "kind": "core",
  "switchable": true,
  "needs": ["projects"],
  "worksWith": ["pages", "collections"],
  "permissions": ["sheets.edit", "sheets.comment", "sheets.suggest", "sheets.edit_own"],
  "tools": {
    "sheet_list": "query",
    "sheet_read": "query",
    "sheet_write": "change",
    "sheet_search": "query",
    "sheet_view_list": "query",
    "sheet_view_create": "create",
    "sheet_view_update": "change",
    "sheet_view_delete": "change"
  },
  "routes": ["/api/v1/projects/{project_id}/sheets*"],
  "events": { "emits": ["sheet.updated", "sheet.version_restored", "sheet.views_changed"], "listens": [] },
  "notifications": [],
  "search": ["sheets"],
  "automations": { "triggers": ["sheet_changed"], "actions": [] },
  "things": [
    {
      "kind": "sheet",
      "one": "Sheet",
      "many": "Sheets",
      "href": "/projects/{projectId}/sheets/{id}",
      "fields": [{ "id": "updatedAt", "label": "Edited", "type": "date" }]
    }
  ],
  "links": [],
  "embeds": [],
  "web": { "folder": "sheets" },
  "slots": {
    "pages": ["/projects/:projectId/sheets/*"],
    "parts": ["area.sheets"],
    "sidebar": [],
    "home": [],
    "settings": [],
    "palette": ["p:sheets"],
    "shortcuts": [],
    "slash": [],
    "setup": []
  },
  "settings": [],
  "nouns": []
}
