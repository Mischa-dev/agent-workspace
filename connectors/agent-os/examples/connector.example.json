{
  "workspaceOrigin": "https://workspace.example",
  "stateDir": "/var/lib/aw-agentos-connector",
  "hostName": "Agent OS",
  "agentos": {
    "context": "<your Agent OS context>",
    "command": ["agentos", "controller", "call"],
    "timeoutSeconds": 45
  },
  "agents": {
    "<reference the agent is bound with>": {
      "agentosId": "<the agent's id in Agent OS>",
      "name": "<what it is called>"
    }
  },
  "offers": [
    {"id": "<offer id>", "title": "<what it sets up>", "description": "<one line>"}
  ],
  "operations": {
    "listTasks": "<operation that lists tasks>",
    "usage": "<operation that reports usage by plan window>",
    "pause": "<operation that pauses an agent>",
    "memory": "<operation that shows what an agent remembers>"
  },
  "adoptSeconds": 30,
  "pollSeconds": 8,
  "taskDeadlineSeconds": 3600,
  "maxReplyCharacters": 19500
}
